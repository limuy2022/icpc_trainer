# Local development. Copy to .env.local and replace the encryption key.
PORT=5182
APP_ORIGIN=http://127.0.0.1:5182
COOKIE_SECURE=false
# Relative to release/ (the server working directory).
DATABASE_PATH=../data/icpc.sqlite
MODEL_ENCRYPTION_KEY=replace_with_64_hex_characters
# Optional bootstrap model. Leave empty and add models in the admin panel instead.
# Public HTTPS API base URL WITHOUT /chat/completions; no provider is assumed.
# Only used to create the first model when the database has no models.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MODEL_LABEL=
# openai-compatible (default), or glm for GLM-specific thinking parameters.
AI_PROVIDER=openai-compatible
