{
  "name": "icpc-thinking-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12.17.0 <13"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:standalone": "node scripts/build-standalone.mjs",
    "dev:standalone": "vite --config vite.standalone.config.ts",
    "start:standalone": "cd release && node --env-file=.env server.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.16.22",
    "lucide-react": "^1.31.0",
    "parse5": "^8.1.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/hast": "3.0.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.0.13"
  },
  "type": "module",
  "packageManager": "pnpm@12.17.0"
}
