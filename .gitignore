# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

/release/
/data/

# Safe configuration template; never include real credentials here.
!.env.example
*.sqlite
*.sqlite-*
*.db
*.db-*
*.key

# pnpm is the project package manager.
/package-lock.json

# Personal legacy hosting identity is not part of the self-hosted project.
/.openai/hosting.json
.zcode/
